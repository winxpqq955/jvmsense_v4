# Rust build output
/target/
**/*.rs.bk

# Local tool/index state
/.codegraph/
/.jdk/

# Runtime and fixture output generated by local launches
/apps/core/.fabric/
/apps/core/config/
/apps/core/logs/
/apps/core/crash-reports/

# Generated example/fixture trees. Tests download what they need on demand.
/examples/*
!examples/native-dll/
/examples/native-dll/*
!examples/native-dll/src/
!examples/native-dll/src/**
/*.jar

# Spikes are intentionally outside the Cargo workspace; preserve only the
# architecture findings referenced by crate documentation.
/spikes/*
!/spikes/FINDINGS.md

# Local one-off probes and machine artifacts
/probe_fd_fields.py

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.tmp
